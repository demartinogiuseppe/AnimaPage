# Names only, never real values. Copy to server/.env (git-ignored).
PAGINAVIVA_MODE=mock            # live | mock
PAGINAVIVA_PORT=8787            # API server port
PAGINAVIVA_HOST=127.0.0.1       # API bind address (the phone goes through Vite); non-loopback only with PAGINAVIVA_ALLOW_REMOTE=1 (no auth, docs/security.md)
PAGINAVIVA_LLM=claude-cli       # mock | claude-cli | gemini-cli | local  (server default; the app can choose per phase, D20)
PAGINAVIVA_CLAUDE_MODEL=opus    # model alias passed to the CLI (see docs/models.md)
PAGINAVIVA_CLAUDE_BIN=          # path to the claude executable; empty = from PATH
PAGINAVIVA_LOCAL_LLM_URL=       # OpenAI-compatible endpoint for PAGINAVIVA_LLM=local; empty = Ollama, http://localhost:11434/v1
PAGINAVIVA_LOCAL_LLM_MODEL=     # model for PAGINAVIVA_LLM=local, e.g. gemma3:4b
PAGINAVIVA_GEMINI_BIN=          # path to the gemini executable (or a .js/.mjs file run with Node); empty = from PATH
PAGINAVIVA_GEMINI_MODEL=        # -m value for PAGINAVIVA_LLM=gemini-cli; empty = auto
# Keys for the OpenAI-compatible entries of server/config/llm_providers.yaml (apiKeyEnv names).
# Only needed if you uncomment such an entry; leave empty otherwise. Never put keys anywhere else.
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
PAGINAVIVA_LEDGER=              # ledger file path; empty = default ledger.jsonl
YOUTUBE_API_KEY=                # optional: free YouTube Data API v3 key; videos from YouTube are enabled when set (decision D15 in docs/decisions.md)
PAGINAVIVA_STORE_PHOTOS=false   # photos are not stored by default
PAGINAVIVA_VISUAL_CHECK=        # true | false; empty = on in live mode, off in mock mode (render the scene in Chrome, Claude compares it with the page)
PAGINAVIVA_WEB_URL=             # web player used by the visual check; empty = http://localhost:5173 (the Vite dev server)
PAGINAVIVA_GENERATE_EFFORT=     # reasoning effort of the scene generation with the Claude CLI; empty = default
PAGINAVIVA_LESSONS_DIR=         # lesson archive folder; empty = server/data/lessons (git-ignored; holds generated scenes, never photos)
PAGINAVIVA_MAX_PIPELINES=       # photo pipelines running at once; empty = 1 (more uploads get 429, docs/security.md)
PAGINAVIVA_PAGES_PER_HOUR=      # photo uploads per device per hour; empty = 60
PAGINAVIVA_I18N_MAX_CATALOGS=   # UI catalogs the server may translate and keep (live); empty = 40
# Not read from this file: PAGINAVIVA_API_URL, PAGINAVIVA_HTTPS_KEY and PAGINAVIVA_HTTPS_CERT are set in the shell
# for the Vite dev server (see docs/dev-setup.md).
