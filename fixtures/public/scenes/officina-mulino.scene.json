      "title": "L'acqua fa girare la ruota",
      "chip": "Ruota",
      "kind": "science",
      "duration": 34,
      "narration": [
        {
          "at": 0,
          "text": "Questo è un mulino ad acqua: usa la forza dell'acqua per macinare il grano.",
          "highlight": [
            "p-ruota"
          ],
          "sourceIds": [
            "page",
            "w-mulino"
          ]
        },
        {
          "at": 5,
          "text": "L'acqua arriva dalla gora, una vasca in alto, e scorre nel canale.",
          "highlight": [
            "p-gora"
          ],
          "sourceIds": [
            "page"
          ]
        },
        {
          "at": 11,
          "text": "Cade sulle pale della ruota: il suo peso le spinge verso il basso.",
          "highlight": [
            "p-forza"
          ],
          "sourceIds": [
            "page"
          ]
        },
        {
          "at": 17,
          "text": "Una pala scende, la successiva prende il suo posto: la ruota gira senza fermarsi.",
          "highlight": [],
          "sourceIds": [
            "page"
          ]
        },
        {
          "at": 24,
          "text": "Poi l'acqua torna nel fosso e continua il suo corso verso valle.",
          "highlight": [],
          "sourceIds": [
            "page"
          ]
        },
        {
          "at": 29,
          "text": "Prova tu: cambia la portata e guarda la ruota.",
          "highlight": [],
          "sourceIds": []
        }
