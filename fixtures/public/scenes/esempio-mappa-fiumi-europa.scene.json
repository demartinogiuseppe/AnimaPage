      "narration": [
        {
          "at": 0,
          "text": "Questa è l'Europa, con i suoi fiumi più grandi.",
          "highlight": [],
          "sourceIds": [
            "page"
          ]
        },
        {
          "at": 3.8,
          "text": "Un fiume raccoglie l'acqua delle piogge e delle nevi e la porta fino al mare.",
