  "chapters": [
    {
      "id": "mattina",
      "title": "Una sorpresa per il nonno",
      "chip": "L'inizio",
      "book": {
        "heading": "Situazione iniziale",
        "formula": "chi? · dove? · quando?",
        "lines": [
          "Chi: Lucia, la mamma, il cane Pepe.",
          "Dove: il giardino di casa.",
          "Quando: un sabato mattina, il giorno del compleanno del nonno."
        ],
        "sourceIds": [
          "page"
        ]
      },
      "activity": {
        "predict": {
          "q": "Pepe segue la torta annusando. Che cosa farà secondo te?",
          "options": [
            "Si addormenta al sole",
            "Combina un guaio",
            "Va a chiamare il nonno"
          ],
          "answer": 1
        },
        "test": {
          "prompt": "Guarda Pepe mentre Lucia porta la torta: dove tiene il naso?"
        },
        "prove": {
          "text": "Pepe non perde d'occhio la torta: nel prossimo capitolo combinerà un bel guaio.",
          "sourceIds": [
            "page"
          ]
        },
        "stamp": "Lettore attento"
      },
      "kind": "mixed",
      "duration": 30.6,
      "narration": [
        {
          "at": 0,
          "text": "È sabato mattina e oggi il nonno Bruno compie settant'anni.",
          "highlight": [],
          "sourceIds": [
            "page"
          ]
        },
        {
          "at": 4.6,
          "text": "Lucia ha preparato con la mamma una torta alle fragole: è una sorpresa.",
          "highlight": [
            "lucia",
            "mamma"
          ],
          "sourceIds": [
            "page"
          ]
        },
        {
          "at": 10.1,
          "text": "La porta con cura fino al tavolo in giardino, un passo alla volta.",
          "highlight": [
            "lucia",
            "torta"
          ],
          "sourceIds": [
            "page"
          ]
        },
        {
          "at": 15.2,
          "text": "Pepe, il cane di casa, la segue annusando l'aria.",
          "highlight": [
            "pepe"
          ],
          "sourceIds": [
            "page"
          ]
        },
        {
          "at": 19.1,
          "text": "«Tu non la tocchi, intesi?» gli dice Lucia, e la posa sul tavolo.",
          "highlight": [
            "lucia",
            "pepe"
          ],
          "sourceIds": [
            "page"
          ]
        },
        {
          "at": 24.2,
          "text": "Tutto è pronto. Manca solo il nonno, che arriverà a mezzogiorno.",
          "highlight": [],
          "sourceIds": [
            "page"
          ]
        }
      ],
      "camera": [
