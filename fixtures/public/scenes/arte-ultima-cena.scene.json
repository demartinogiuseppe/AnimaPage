   "narration": [
    {
     "at": 0,
     "text": "Siamo a Milano, nel refettorio del convento di Santa Maria delle Grazie: su questa parete Leonardo da Vinci dipinse l'Ultima Cena, tra il 1494 e il 1498.",
     "highlight": [],
     "sourceIds": [
      "w-cenacolo"
     ]
    },
    {
     "at": 9,
     "text": "Il lavoro gli fu commissionato da Ludovico il Moro, duca di Milano.",
     "highlight": [],
     "sourceIds": [
      "w-cenacolo"
     ]
    },
    {
     "at": 14,
     "text": "Leonardo racconta un momento preciso del Vangelo di Giovanni: Gesù ha appena annunciato che uno dei suoi apostoli lo tradirà.",
     "highlight": [],
     "sourceIds": [
      "w-cenacolo"
     ]
    },
    {
     "at": 21,
     "text": "Al centro c'è Cristo, isolato, con il capo reclinato e la bocca appena socchiusa, come se avesse appena finito di parlare.",
     "highlight": [
      "p-cristo"
     ],
     "sourceIds": [
      "w-cenacolo"
     ]
    },
    {
     "at": 30,
     "text": "Pietro, con il coltello in mano, si sporge verso Giovanni e gli chiede chi sia il traditore.",
     "highlight": [
      "p-pietro",
      "p-giovanni"
     ],
     "sourceIds": [
      "w-cenacolo"
     ]
    },
    {
     "at": 37,
     "text": "Davanti a lui Giuda stringe la borsa con i soldi e si tira indietro, con aria colpevole.",
     "highlight": [
      "p-giuda"
     ],
     "sourceIds": [
      "w-cenacolo"
     ]
    },
    {
     "at": 44,
     "text": "Dall'altra parte Giacomo il Maggiore spalanca le braccia, attonito; vicino a lui Filippo porta le mani al petto.",
     "highlight": [
      "p-giacomo",
      "p-filippo"
     ],
     "sourceIds": [
      "w-cenacolo"
     ]
    },
    {
     "at": 51,
     "text": "All'estrema destra Matteo, Giuda Taddeo e Simone esprimono con gesti concitati il loro smarrimento.",
