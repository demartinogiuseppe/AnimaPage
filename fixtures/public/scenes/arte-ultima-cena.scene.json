   "deep": [
    {
     "text": "Non è un vero affresco: Leonardo dipinse «a secco» su intonaco, con una tempera grassa, per poter ritoccare con calma come faceva sulle tavole di legno.",
     "sourceIds": [
      "w-cenacolo"
     ]
    },
    {
     "text": "Proprio questa tecnica, con l'umidità del muro confinante con le cucine, rovinò presto il dipinto: Vasari, che lo vide nel 1566, scrisse che si scorgeva ormai solo «una macchia abbagliata».",
     "sourceIds": [
      "w-cenacolo"
     ]
    },
    {
     "text": "Nell'agosto del 1943 un bombardamento distrusse la volta del refettorio, ma il dipinto si salvò, protetto da sacchi di sabbia.",
     "sourceIds": [
      "w-cenacolo"
     ]
    },
    {
     "text": "L'ultimo grande restauro durò dal 1978 al 1999, con la restauratrice Pinin Brambilla. Dal 1980 il Cenacolo, con la chiesa e il convento, è patrimonio dell'umanità UNESCO.",
     "sourceIds": [
      "w-cenacolo"
     ]
    }
   ],
   "quiz": [
    {
     "type": "choice",
     "q": "Da dove arriva la luce nel dipinto?",
     "options": [
      "Da sinistra",
      "Da destra",
      "Dal basso"
     ],
     "answer": 0,
     "explain": "Da sinistra, come la luce delle finestre vere del refettorio."
    },
    {
     "type": "pick",
     "q": "Tocca il gruppo di Giuda, Pietro e Giovanni.",
     "answerPins": [
      "p-g2"
     ],
     "explain": "È il secondo gruppo, il più vicino a Cristo sul lato sinistro."
    },
    {
     "type": "choice",
     "q": "Perché il dipinto si è rovinato così presto?",
     "options": [
      "Leonardo dipinse a secco su un muro umido",
      "Fu colpito da un fulmine",
      "Fu dipinto su una tavola di legno"
     ],
     "answer": 0,
     "explain": "La tecnica a secco non resisteva all'umidità della parete, vicina alle cucine."
    }
   ],
