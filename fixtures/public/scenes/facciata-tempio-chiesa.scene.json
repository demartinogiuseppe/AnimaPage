  "chapters": [
    {
      "id": "nettuno",
      "title": "Un tempio greco",
      "chip": "Paestum",
      "kind": "art",
      "duration": 40,
      "narration": [
        {
          "at": 0,
          "text": "A Paestum, in Campania, un tempio greco è arrivato fino a noi in ottimo stato.",
          "highlight": [],
          "sourceIds": [
            "w-nettuno"
          ]
        },
        {
          "at": 7,
          "text": "Il nome «di Nettuno» è una vecchia attribuzione: a quale dio fosse dedicato davvero non si sa.",
          "highlight": [],
          "sourceIds": [
            "w-nettuno"
          ]
        },
        {
          "at": 14,
          "text": "È in stile dorico: colonne robuste e un frontone triangolare.",
          "highlight": [
            "p-colonne"
          ],
          "sourceIds": [
            "w-nettuno"
          ]
        },
        {
          "at": 21,
          "text": "Sulla fronte ci sono sei colonne.",
          "highlight": [
            "p-colonne"
          ],
          "sourceIds": [
            "w-nettuno"
          ]
        },
        {
          "at": 26,
          "text": "Sopra le colonne corre la trabeazione, e poi il frontone triangolare.",
          "highlight": [
            "p-frontone"
          ],
          "sourceIds": [
            "w-nettuno"
          ]
        },
        {
          "at": 32,
          "text": "Ora lo guardiamo in assonometria, e vediamo anche quanto è lungo.",
          "highlight": [],
          "sourceIds": []
        }
      ],
      "camera": [],
      "pins": [
