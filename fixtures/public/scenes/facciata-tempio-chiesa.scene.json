    {
      "id": "miniato",
      "title": "Una chiesa romanica",
      "chip": "Romanico",
      "kind": "art",
      "duration": 42,
      "narration": [
        {
          "at": 0,
          "text": "San Miniato al Monte è una chiesa di Firenze, costruita su una collina.",
          "highlight": [],
          "sourceIds": [
            "w-miniato"
          ]
        },
        {
          "at": 7,
          "text": "È in stile romanico: usa archi rotondi.",
          "highlight": [],
          "sourceIds": [
            "w-miniato"
          ]
        },
        {
          "at": 13,
          "text": "In basso ci sono cinque archi rotondi, appoggiati a mezze colonne.",
          "highlight": [
            "p-archi"
          ],
          "sourceIds": [
            "w-miniato"
          ]
        },
        {
          "at": 20,
          "text": "In alto la facciata è più stretta e finisce con un frontone.",
          "highlight": [
            "p-alto"
          ],
          "sourceIds": [
            "w-miniato"
          ]
        },
        {
          "at": 27,
          "text": "Sulla chiesa vera i marmi bianchi e verdi formano disegni. Noi li lasciamo fuori: disegniamo solo linee.",
          "highlight": [],
          "sourceIds": [
            "w-miniato"
          ]
        },
        {
          "at": 35,
          "text": "Per finire, la guardiamo in prospettiva.",
          "highlight": [],
          "sourceIds": []
        }
      ],
      "camera": [],
      "pins": [
        {
