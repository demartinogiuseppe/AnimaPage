    {
      "id": "ordini",
      "title": "I tre ordini",
      "chip": "Ordini",
      "kind": "art",
      "duration": 40,
      "narration": [
        {
          "at": 0,
          "text": "Guarda le lesene: sono pilastri piatti, appoggiati al muro.",
          "highlight": [
            "p-les0"
          ],
          "sourceIds": []
        },
        {
          "at": 6,
          "text": "Su ogni piano le lesene seguono un ordine diverso, uno sopra l'altro, ispirandosi all'architettura romana antica.",
          "highlight": [],
          "sourceIds": [
            "w-rucellai"
          ]
        },
        {
          "at": 12,
          "text": "In basso c'è l'ordine tuscanico, il più semplice.",
          "highlight": [
            "p-les0"
          ],
          "sourceIds": [
            "w-rucellai"
          ]
        },
        {
          "at": 18,
          "text": "Al primo piano c'è l'ordine composito.",
          "highlight": [
            "p-les1"
          ],
          "sourceIds": [
            "w-rucellai"
          ]
        },
        {
          "at": 24,
          "text": "Al secondo piano c'è l'ordine corinzio.",
          "highlight": [
            "p-les2"
          ],
          "sourceIds": [
            "w-rucellai"
          ]
        },
        {
          "at": 31,
          "text": "È un'idea che viene dai monumenti dell'antica Roma. Alberti li studiava con attenzione.",
          "highlight": [],
          "sourceIds": [
            "w-alberti"
          ]
        }
      ],
