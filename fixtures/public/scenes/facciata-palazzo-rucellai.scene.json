  "chapters": [
    {
      "id": "disegno",
      "title": "La facciata disegnata",
      "chip": "Disegno",
      "kind": "art",
      "duration": 44,
      "narration": [
        {
          "at": 0,
          "text": "Questo è Palazzo Rucellai, a Firenze. Lo vediamo di fronte, disegnato solo con linee.",
          "highlight": [],
          "sourceIds": [
            "w-rucellai"
          ]
        },
        {
          "at": 6,
          "text": "La facciata è di Leon Battista Alberti, e i lavori furono diretti da Bernardo Rossellino, nel Quattrocento.",
          "highlight": [],
          "sourceIds": [
            "w-rucellai",
            "w-alberti"
          ]
        },
        {
          "at": 12,
          "text": "Lo disegniamo piano dopo piano, come farebbe un architetto. Prima il basamento.",
          "highlight": [],
          "sourceIds": []
        },
        {
          "at": 16,
          "text": "Al piano terra il muro è fatto di blocchi squadrati e lisci. Si chiama bugnato.",
          "highlight": [
            "p-bugnato"
          ],
          "sourceIds": [
            "w-rucellai"
          ]
        },
        {
          "at": 23,
          "text": "Al primo piano le finestre sono bifore: due luci sotto un solo arco.",
          "highlight": [
            "p-bifora"
          ],
          "sourceIds": [
            "w-rucellai"
          ]
        },
        {
          "at": 30,
          "text": "Il secondo piano ripete lo schema, ma è un po' più basso. In cima c'è il cornicione.",
          "highlight": [
            "p-cornicione"
          ],
          "sourceIds": [
            "w-rucellai"
          ]
        },
        {
          "at": 38,
          "text": "Una fascia orizzontale separa un piano dal successivo.",
          "highlight": [],
          "sourceIds": []
        }
      ],
      "camera": [],
