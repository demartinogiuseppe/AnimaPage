      "kind": "mixed",
      "duration": 34,
      "narration": [
        {
          "at": 0,
          "text": "Il nome è la parte del discorso che indica persone, animali, cose, luoghi e idee.",
          "highlight": [],
          "sourceIds": [
            "page",
            "w-sostantivo"
          ]
        },
        {
          "at": 6.1,
          "text": "Ecco un mucchio di nomi da mettere in ordine.",
          "highlight": [],
          "sourceIds": [
            "page"
          ]
        },
        {
          "at": 9.8,
          "text": "Alcuni sono generici: città, cane, fiume, ragazza. Sono nomi comuni.",
          "highlight": [
            "p-comune"
          ],
          "sourceIds": [
            "page",
            "w-sostantivo"
          ]
        },
        {
          "at": 15,
          "text": "Altri indicano proprio quella persona, quell'animale, quel luogo: sono nomi propri.",
          "highlight": [
            "p-proprio"
          ],
          "sourceIds": [
            "page",
            "w-nome-proprio"
          ]
        },
        {
          "at": 21.3,
          "text": "Roma è una città, Fido è un cane, il Tevere è un fiume, Giulia è una ragazza.",
          "highlight": [
            "p-roma"
          ],
          "sourceIds": [
            "page"
          ]
        },
        {
          "at": 27.1,
          "text": "Hai notato? I nomi propri si scrivono sempre con la lettera maiuscola.",
          "highlight": [
            "p-maiuscola"
          ],
          "sourceIds": [
            "page",
            "w-nome-proprio"
          ]
        }
      ],
