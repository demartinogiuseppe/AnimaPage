      "deep": [
        {
          "text": "Nel 1971, durante la missione Apollo 15, l'astronauta David Scott lasciò cadere sulla Luna, dove non c'è aria, un martello e una piuma: toccarono il suolo insieme, come aveva previsto Galileo.",
          "sourceIds": [
            "w-apollo15"
          ]
        },
        {
          "text": "Sulla Terra una piuma cade più lentamente di un sasso solo per la resistenza dell'aria. In questo laboratorio l'aria è trascurata.",
          "sourceIds": [
            "w-apollo15"
          ]
        }
      ],
      "quiz": [
        {
          "type": "choice",
          "q": "In quale momento l'energia cinetica della palla è massima?",
          "options": [
            "Appena prima di toccare terra",
            "A metà della caduta",
            "Nell'istante in cui parte"
          ],
          "answer": 0,
          "explain": "La palla accelera per tutta la caduta: la velocità, e quindi Ec = ½·m·v², è massima appena prima dell'urto."
        },
        {
          "type": "pick",
          "q": "Tocca la provetta dell'energia che cresce mentre la palla cade.",
          "answerPins": [
            "p-ec"
          ],
          "explain": "Cresce l'energia cinetica: la palla va sempre più veloce."
        }
      ],
      "book": {
        "heading": "La caduta libera",
        "formula": "h = ½ · g · t²",
        "lines": [
          "Senza aria tutti i corpi cadono con la stessa accelerazione g ≈ 9,8 m/s².",
          "Il tempo di caduta non dipende dalla massa.",
          "Ep = m·g·h si trasforma in Ec = ½·m·v²."
        ],
        "sourceIds": [
