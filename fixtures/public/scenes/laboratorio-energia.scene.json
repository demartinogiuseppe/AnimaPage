    {
      "id": "pendolo",
      "title": "Il pendolo",
      "chip": "Pendolo",
      "kind": "science",
      "duration": 46,
      "narration": [
        {
          "at": 0,
          "text": "Ora un pendolo: una pallina di 0,5 kg appesa a un filo lungo 1 metro.",
          "speech": "Ora un pendolo: una pallina di mezzo chilo appesa a un filo lungo un metro.",
          "highlight": [
            "p-bob"
          ],
          "sourceIds": [
            "calc"
          ]
        },
        {
          "at": 6,
          "text": "La spostiamo di 20 gradi e la lasciamo andare.",
          "speech": "La spostiamo di venti gradi e la lasciamo andare.",
          "highlight": [],
          "sourceIds": [
            "calc"
          ]
        },
        {
          "at": 11,
          "text": "Agli estremi la pallina è ferma: ha solo energia potenziale. In basso è più veloce: ha solo energia cinetica.",
          "highlight": [
            "p-ep",
            "p-ec"
          ],
          "sourceIds": [
            "w-pendolo"
          ]
        },
        {
          "at": 19,
          "text": "Le due energie si scambiano a ogni oscillazione, ma la loro somma non cambia.",
          "highlight": [
            "p-rest"
          ],
          "sourceIds": [
            "w-pendolo",
            "w-energia"
          ]
        },
        {
          "at": 26,
          "text": "Il periodo, il tempo di un'andata e ritorno, con un filo di 1 metro è circa 2 secondi.",
          "speech": "Il periodo, il tempo di un'andata e ritorno, con un filo di un metro è circa due secondi.",
          "highlight": [
            "p-board"
          ],
          "sourceIds": [
            "calc",
            "w-pendolo"
          ]
        },
        {
          "at": 34,
          "text": "Il periodo dipende dalla lunghezza del filo, non dalla massa: provalo con i cursori.",
          "highlight": [],
          "sourceIds": [
            "w-pendolo"
          ]
        },
        {
          "at": 40,
          "text": "Per piccole oscillazioni non dipende neppure dall'ampiezza: è l'isocronismo descritto da Galileo.",
          "highlight": [
            "p-pivot"
          ],
          "sourceIds": [
            "w-pendolo"
          ]
        }
