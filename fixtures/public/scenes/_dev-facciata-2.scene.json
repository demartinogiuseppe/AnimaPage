      "deep": [],
      "quiz": []
    },
    {
      "id": "romanico",
      "title": "La chiesa romanica",
      "chip": "Romanico",
      "kind": "art",
      "duration": 12,
      "narration": [
        {
          "at": 0,
          "text": "Due registri: in basso arcate cieche e il portale a più archi rientranti, in alto la loggetta e le falde delle navate che salgono al timpano.",
          "highlight": [],
          "sourceIds": [
            "page"
          ]
        }
      ],
      "camera": [
        {
          "at": 0,
          "target": {
            "entity": "building"
