  "chapters": [
    {
      "id": "tempio",
      "title": "Il tempio dorico",
      "chip": "Tempio",
      "kind": "art",
      "duration": 12,
      "narration": [
        {
          "at": 0,
          "text": "Sei colonne doriche davanti alla cella, su uno stilobate a gradini; sopra la trabeazione con i triglifi, poi il frontone.",
          "highlight": [],
          "sourceIds": [
            "page"
          ]
        }
      ],
      "camera": [
        {
          "at": 0,
          "target": {
            "entity": "building"
          },
