          "sourceIds": [
            "page"
          ]
        },
        {
          "at": 12.5,
          "text": "Hello! What would you like?",
          "speaker": "sam",
          "highlight": [
            "sam"
          ],
          "sourceIds": [
            "page"
          ]
        },
        {
          "at": 16,
          "text": "«What would you like?» vuol dire: che cosa desiderate?",
          "highlight": [],
          "sourceIds": [
            "page"
          ]
        },
        {
          "at": 20,
          "text": "A cappuccino, please.",
          "speaker": "anna",
          "highlight": [
            "anna"
          ],
          "sourceIds": [
            "page"
          ]
        },
        {
          "at": 23,
          "text": "Can I have a croissant, please?",
          "speaker": "tom",
          "highlight": [
            "tom"
          ],
          "sourceIds": [
            "page"
          ]
        },
        {
          "at": 26.5,
          "text": "Of course. Anything else?",
          "speaker": "sam",
          "highlight": [
            "sam"
          ],
          "sourceIds": [
            "page"
          ]
        },
        {
          "at": 29.5,
          "text": "No, thank you.",
          "speaker": "tom",
          "highlight": [
            "tom"
          ],
          "sourceIds": [
            "page"
          ]
        },
        {
          "at": 32.5,
          "text": "«Please» vuol dire per favore, «thank you» vuol dire grazie: con queste due parole ordini in modo gentile.",
