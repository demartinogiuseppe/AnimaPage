      "narration": [
        {
          "at": 0,
          "text": "Ora guardiamo il territorio: com'è fatta la Campania?",
          "highlight": [],
          "sourceIds": []
        },
        {
          "at": 4,
          "text": "Il libro lo divide in tre fasce: collina, montagna e pianura.",
          "highlight": [],
          "sourceIds": [
            "page"
          ]
        },
        {
          "at": 10,
          "text": "La collina è la fascia più grande: il 51 per cento, più della metà.",
          "highlight": [
